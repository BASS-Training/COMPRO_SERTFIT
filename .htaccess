DirectoryIndex index.html

RewriteEngine On

# Keep the homepage at the document root.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

# Redirect old root-level .html URLs to their extensionless equivalents.
RewriteCond %{THE_REQUEST} \s/+([^/\s?]+)\.html(?:[\s?]|$) [NC]
RewriteRule ^([^/]+)\.html$ /$1 [R=301,L,NE]

# Serve extensionless pages from the pages directory.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
RewriteRule ^([^/]+)/?$ pages/$1.html [L]
